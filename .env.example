# ---- LLM (OpenRouter free models via LiteLLM) ----
OPENROUTER_API_KEY=sk-or-...
# Default = OpenRouter's free router (picks a random free model each call - can be slow, often a "thinking" model).
# For faster replies, pin ONE free model that supports tools and is not a reasoning/thinking model:
# openrouter.ai/models -> filter Prices: Free + Supported parameters: tools -> copy its id, e.g.
# MILO_MODEL=openrouter/<provider>/<model>:free
# The server log prints "chat turn: first response Xs, total Ys" so you can compare models.
MILO_MODEL=openrouter/openrouter/free

# ---- Meta Marketing API (live business account: Facebook + Instagram) ----
META_API_VERSION=v26.0
META_ACCESS_TOKEN=            # Business system-user token: ads_management, ads_read, pages_read_engagement,
                              # pages_show_list, instagram_basic, business_management
META_AD_ACCOUNT_ID=           # ad account id, e.g. 1234567890 ("act_" prefix optional)
META_PAGE_ID=                 # Facebook Page the ads run under
# META_PAGE_NAME=Milo Test Page        # optional: Page name shown on Milo's own ad mock-up
# META_INSTAGRAM_ACCOUNT_ID=           # optional: Instagram account linked to the Page (found automatically if empty)
# META_PAGE_POST_ID=                   # optional: boost an existing Page post instead of Milo's own ad copy
META_DRY_RUN=true             # true = never call Meta, log requests only. Set false to work on the live account.
# DM webhook (POST /webhooks/meta). Leave empty to keep the webhook off.
# META_APP_SECRET=                     # App Dashboard > App settings > Basic > App secret (signs every event)
# META_WEBHOOK_VERIFY_TOKEN=           # any long random string; type the same value in the App Dashboard

# ---- Spend safety (live account) ----
META_ALLOW_SPEND=false        # false = campaigns are created on Meta but stay PAUSED: no delivery, no charge.
                              # Resume is refused until this is true (only with the account owner's OK).
MAX_DAILY_BUDGET_INR=500      # hard cap per campaign, for every request (Milo, buttons, optimizer)
MAX_TOTAL_DAILY_BUDGET_INR=1000   # hard cap across all running campaigns

# ---- Metrics ----
METRICS_PROVIDER=meta         # meta = real Insights | simulated = demo data. Dry run always uses simulated.
METRICS_POLL_MINUTES=15
# APPROVAL_TIMEOUT_MINUTES=10        # an approval stuck "executing" this long goes back to pending

# ---- Web research for ad copy (Tavily, free plan: 1,000 credits/month; one search = 1 credit) ----
TAVILY_API_KEY=
# RESEARCH_ENABLED=true
# RESEARCH_TIME_RANGE=month          # day | week | month | year
# RESEARCH_MAX_RESULTS=5

# ---- Ad image generation: FLUX.1 [schnell] on Cloudflare Workers AI (free: 10,000 neurons/day ~ 150+ images) ----
# dash.cloudflare.com -> AI -> Workers AI -> Use REST API: copy the Account ID, "Create a Workers AI API Token".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell   # FLUX.1 [schnell] by Black Forest Labs (Apache-2.0)
# IMAGE_STEPS=4                                      # 1-8
# IMAGE_DAILY_LIMIT=40                               # Milo's own cap per day

# ---- Optimizer (files recommendations as approvals after each metrics pull; never auto-applies) ----
OPTIMIZER_ENABLED=true
# OPTIMIZER_MIN_IMPRESSIONS=1000     # ignore campaigns with less 7-day data
# OPTIMIZER_PAUSE_CTR_RATIO=0.6      # pause if CTR < 60% of account average
# OPTIMIZER_SCALE_CTR_RATIO=1.2      # +budget if CTR >= 120% of average and CPC <= average
# OPTIMIZER_TRIM_CPC_RATIO=1.3       # -budget if CPC > 130% of average
# OPTIMIZER_BUDGET_STEP_PCT=20
# OPTIMIZER_MIN_CTR_PCT=0.6          # single-campaign pause floor
# OPTIMIZER_COOLDOWN_HOURS=6

# ---- Database: MongoDB Atlas (free M0) or local MongoDB ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=milo

# ---- API protection ----
# ALLOWED_HOSTS=localhost,127.0.0.1    # Host names the server answers to (blocks DNS rebinding)
# API_TOKEN=                           # set to require "Authorization: Bearer <token>" (for use beyond localhost)

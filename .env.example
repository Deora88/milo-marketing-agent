# ---- LLM (OpenRouter free models via LiteLLM) ----
OPENROUTER_API_KEY=sk-or-...
# Default = OpenRouter's free router (picks a random free model each call - can be slow, often a "thinking" model).
# For faster replies, pin ONE free model that supports tools and is not a reasoning/thinking model:
# openrouter.ai/models -> filter Prices: Free + Supported parameters: tools -> copy its id, e.g.
# MILO_MODEL=openrouter/<provider>/<model>:free
# The server log prints "chat turn: first response Xs, total Ys" so you can compare models.
MILO_MODEL=openrouter/openrouter/free

# ---- Meta Marketing API ----
META_API_VERSION=v26.0
META_ACCESS_TOKEN=            # system user token (ads_management, ads_read)
META_AD_ACCOUNT_ID=           # sandbox ad account id, e.g. 1234567890 ("act_" prefix optional)
META_PAGE_ID=                 # Facebook Page the ads run under
# META_PAGE_NAME=Milo Test Page  # optional: Page name shown on Milo's own ad mock-up
# META_PAGE_POST_ID=           # optional: use an existing Page post as the ad (needed while the Meta app is in
#                              # Development mode). Post id, "pageid_postid", or the post's URL.
META_DRY_RUN=true             # true = never call Meta, log requests only (safe for development)

# ---- Metrics ----
METRICS_PROVIDER=simulated    # simulated | meta  (sandbox accounts return no Insights)
METRICS_POLL_MINUTES=15

# ---- Web research for ad copy (Tavily, free plan: 1,000 credits/month; one search = 1 credit) ----
TAVILY_API_KEY=
# RESEARCH_ENABLED=true
# RESEARCH_TIME_RANGE=month          # day | week | month | year
# RESEARCH_MAX_RESULTS=5

# ---- Optimizer (files recommendations as approvals after each metrics pull; never auto-applies) ----
OPTIMIZER_ENABLED=true
# OPTIMIZER_MIN_IMPRESSIONS=1000     # ignore campaigns with less 7-day data
# OPTIMIZER_PAUSE_CTR_RATIO=0.6      # pause if CTR < 60% of account average
# OPTIMIZER_SCALE_CTR_RATIO=1.2      # +budget if CTR >= 120% of average and CPC <= average
# OPTIMIZER_TRIM_CPC_RATIO=1.3       # -budget if CPC > 130% of average
# OPTIMIZER_BUDGET_STEP_PCT=20
# OPTIMIZER_MAX_DAILY_BUDGET_INR=5000
# OPTIMIZER_MIN_CTR_PCT=0.6          # single-campaign pause floor
# OPTIMIZER_COOLDOWN_HOURS=6

# ---- App ----
DATABASE_URL=sqlite:///./milo.db
